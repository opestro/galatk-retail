PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/galatk_retail
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
GALATK_INTEGRATION_API_KEY=change-me-integration-key
GALATK_INTEGRATION_STAFF_ID=

# Split domains (same Docker app, Host-based routing)
WEB_HOST=galatk.shop
API_HOST=api.galatk.shop
FRONTEND_ORIGIN=https://galatk.shop
CORS_ORIGINS=https://galatk.shop,https://www.galatk.shop
