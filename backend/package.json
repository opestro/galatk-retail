{
  "name": "galatk-retail-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "dotenv -e config/.env.dev cross-env NODE_ENV=dev tsx watch src/app.ts",
    "build": "tsc && npx prisma generate",
    "start": "node dist/app.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "db:migrate:dev": "dotenv -e config/.env.dev prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:reset": "dotenv -e config/.env.dev cross-env prisma migrate reset",
    "db:seed": "dotenv -e config/.env.dev prisma db seed",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "dotenv -e config/.env.dev tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "bcrypt": "^5.1.1",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.1-alpha.6",
    "vitest": "^3.0.5"
  },
  "packageManager": "yarn@1.22.22"
}
